# Database
DB_PATH=./logs/traffic.db

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_SECRET=your-secret-key-here

# Proxy Settings
PROXY_FILE=./proxies.txt
PROXY_ROTATION_INTERVAL=300000
USE_PROXY=true

# Traffic Settings
MIN_DWELL_TIME=30
MAX_DWELL_TIME=300
BOUNCE_RATE_MIN=40
BOUNCE_RATE_MAX=60
PAGE_DEPTH_MIN=1
PAGE_DEPTH_MAX=3
TARGET_URL=http://your-website.com

# Scheduler
SCHEDULE_ENABLED=true
SCHEDULE_CRON=0 */4 * * *

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/traffic.log

# Stealth Settings
USE_STEALTH=true
RANDOMIZE_FINGERPRINT=true
HEADLESS=false