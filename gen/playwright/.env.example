# Flask
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this
DASHBOARD_PORT=5000

# Database - Use SQLite by default
DATABASE_URL=sqlite:///logs/traffic.db

# Target Website
TARGET_URL=https://example.com

# Proxy Settings
PROXY_FILE=./proxies.txt
USE_PROXY=false
PROXY_ROTATION_INTERVAL=300

# Traffic Settings
MIN_DWELL_TIME=30
MAX_DWELL_TIME=300
BOUNCE_RATE_MIN=40
BOUNCE_RATE_MAX=60
PAGE_DEPTH_MIN=1
PAGE_DEPTH_MAX=3

# Stealth Settings
USE_STEALTH=true
HEADLESS=true
RANDOMIZE_FINGERPRINT=true

# Scheduler
SCHEDULE_ENABLED=false
SCHEDULE_INTERVAL=3600
SCHEDULE_VISITS_PER_RUN=25

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/traffic.log

# Auto-start
AUTO_START=false
AUTO_VISITS_PER_HOUR=10
AUTO_DURATION_MINUTES=60